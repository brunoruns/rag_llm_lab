# Omgevingsvariabelen voor het RAG Labo
# Kopieer dit bestand naar .env en vul aan waar nodig

# Tijdelijke folder voor geüploade documenten
TEMP_FOLDER = './_temp'

# Pad waar ChromaDB zijn data opslaat
CHROMA_PATH = 'chroma'

# Naam van de collectie in de vector database
COLLECTION_NAME = 'local-rag'

# Welk Ollama model gebruik je voor tekstgeneratie?
# Aangeraden: llama3.2:3b (klein en snel), llama3.2:1b (snelst op CPU zonder GPU),
#             phi4 (sterker), mistral (origineel)
LLM_MODEL = 'llama3.2:3b'

# Welk Ollama model gebruik je voor embeddings?
# nomic-embed-text is klein en snel - ideaal voor dit labo
TEXT_EMBEDDING_MODEL = 'nomic-embed-text'